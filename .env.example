# TheBookMyVenues — Environment Configuration

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/thebookmyvenues?schema=public"

# Redis Cache & Hold Lock Provider
REDIS_URL="redis://localhost:6379"

# Booking Engine Mode: "postgres" | "mock"
BOOKING_BACKEND="postgres"

# Payment Gateway (Razorpay / Stripe / Mock)
PAYMENT_PROVIDER="mock"
PAYMENT_KEY_ID="rzp_test_placeholder"
PAYMENT_KEY_SECRET="placeholder_secret"
WEBHOOK_SECRET="whsec_placeholder"

# Default Venue Timezone
DEFAULT_TIMEZONE="Asia/Kolkata"
