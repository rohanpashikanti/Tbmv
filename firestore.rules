rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId} (matches Firebase Auth UID)
    // Fields:
    //   - uid: string (required, immutable) - Auth UID
    //   - phoneNumber: string (optional, max 15 chars) - User mobile
    //   - name: string (optional, max 100 chars) - Full name
    //   - email: string (optional, max 100 chars) - Email address
    //   - role: string (required) - 'CUSTOMER' | 'VENDOR' | 'ADMIN'
    //   - status: string (required) - 'ACTIVE' | 'SUSPENDED'
    //   - createdAt: timestamp (required, immutable)
    //   - updatedAt: timestamp (required)
    //
    // Collection: venues
    // Document ID: {venueId}
    // Fields:
    //   - vendorId: string (required, immutable) - Vendor UID
    //   - name: string (required, max 150 chars) - Venue name
    //   - category: string (required) - Venue category
    //   - city: string (required, max 50 chars) - City
    //   - address: string (required, max 250 chars) - Physical location
    //   - pricePerHour: number (required, positive)
    //   - featured: bool (required)
    //   - status: string (required) - 'ACTIVE' | 'PAUSED' | 'CLOSED'
    //
    // Collection: bookings
    // Document ID: {bookingId}
    // Fields:
    //   - bookingNumber: string (required, max 20 chars)
    //   - userId: string (required, immutable) - Customer UID
    //   - venueId: string (required, immutable) - Venue ID
    //   - resourceId: string (required)
    //   - date: string (required)
    //   - startTime: string (required)
    //   - endTime: string (required)
    //   - totalAmount: number (required, positive)
    //   - status: string (required) - 'CONFIRMED' | 'CANCELLED' | 'COMPLETED' | 'REFUNDED'
    //   - checkInState: string (required) - 'PENDING' | 'CHECKED_IN'
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidUser(data) {
      return hasRequiredFields(['uid', 'role', 'status']) &&
             data.uid is string && data.uid.size() > 0 &&
             data.role in ['CUSTOMER', 'VENDOR', 'ADMIN'] &&
             data.status in ['ACTIVE', 'SUSPENDED'];
    }

    function isValidBooking(data) {
      return hasRequiredFields(['bookingNumber', 'userId', 'venueId', 'status', 'totalAmount']) &&
             data.bookingNumber is string && data.bookingNumber.size() <= 20 &&
             data.userId is string && data.userId.size() > 0 &&
             data.venueId is string &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.status in ['CONFIRMED', 'CANCELLED', 'COMPLETED', 'REFUNDED'];
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Users collection: Private PII data - Owner only access
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data) && uidUnchanged() && request.resource.data.role == 'CUSTOMER';
      allow update: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data) && uidNotModified() && areImmutableFieldsUnchanged(['role', 'uid', 'createdAt']);
      allow delete: if false;
    }

    // Venues collection: Publicly readable for discovery, vendor-managed
    match /venues/{venueId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() && (request.auth.uid == request.resource.data.vendorId || request.auth.token.role == 'ADMIN');
    }

    // Bookings collection: Customer-owned and Vendor-accessible
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.vendorId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidBooking(request.resource.data);
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.vendorId == request.auth.uid) && isValidBooking(request.resource.data) && areImmutableFieldsUnchanged(['userId', 'venueId', 'bookingNumber', 'createdAt']);
      allow delete: if false;
    }
  }
}
